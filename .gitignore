# Language-agnostic baseline. Stack-specific ignores get added once
# the stack is chosen in design.

# OS
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.orig
*.rej

# Editor / IDE
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.#*
\#*\#

# Secrets / local env
.env
.env.*
!.env.example

# Claude Code (local settings, history, allowlist — mostly personal).
# Drop the trailing slash so the negations below can re-include
# specific files; with `.claude/` git short-circuits at the
# directory and ignores the !.claude/foo lines.
.claude/*
# Team-shared Claude Code config that SHOULD be in version control:
!.claude/settings.json
!.claude/workflow.md

# Logs / runtime
*.log
*.pid
*.sock

# Coverage / sanitizers
*.gcda
*.gcno
*.gcov
coverage.*
.coverage
lcov.info

# Core dumps
core
core.*
*.core
vgcore.*

# Scratch
scratch/
tmp/
Screenshot_*.png
screenshot*.png

# Roadmap ID counter — derived per-machine cache, not source.
# True high-water mark is the highest ID across ROADMAP.md +
# CHANGELOG.md + docs/roadmap/*.md (roadmap-format.md § 3.5.1).
.roadmap-counter

# ── Content quarantine ────────────────────────────────────────────────
# Nothing under content/ is committed, published, or served to another
# player -- and anything DERIVED from a file under content/ is itself
# under content/. A baked, re-lit, PBR version of an Epic map is still
# Epic's map underneath. See docs/design.md.
/content/

# Belt and braces: Unreal Engine 1 asset formats, anywhere in the tree.
# The reader's tests use SYNTHETIC packages built by the tests
# themselves; real assets live in content/ and are never committed.
*.unr
*.utx
*.uax
*.umx
*.usx
*.u
*.int
*.det
*.dll
*.exe
