ut-ants weapons 1
# The stock weapon set: UT99's Botpack weapons but the Redeemer and the
# Translocator (docs/specs/UTA-0019-weapon-set.md SS 3).
#
# Each number says where it came from:
#   "default: Class.Property" -- the class's default properties, read from
#     the 469 install's Botpack.u by upkg::effectiveDefaults (SS 4.7).
#   "recorded" -- measured from SS 4.7's weapon runs, at 30 and 85 fps
#     where both held their rate. A time is game seconds between shots.
#   "script: Class.Function" -- read from the exported script (SS 4.7) and
#     not yet confirmed by a run.
#   "rule to build" -- the original does more than the key can say; the
#     number is the nearest the key holds until SS 4.9's rule is built.
#   "unmeasured" -- a stand-in. Nothing marked so is trusted; INV-6 checks.

[set]
name = "Stock"
self-damage = 1            # recorded: the hammer and a rocket at the feet hurt the firer in full
head-height = 0.62         # SS 4.9: SniperRifle.ProcessTraceHit
damage-scale = 1.5         # SS 4.9: hardcore, DeathMatchPlus.ReduceDamage; recorded

[weapon impact-hammer]
class = botpack.impacthammer
slot = 1                   # default: ImpactHammer.InventoryGroup
ammo-max = 0               # the hammer needs no ammo
ammo-start = 0
switch-time = 0.84         # recorded: from the Enforcer, key to first shot

[fire impact-hammer primary]
archetype = melee
offset = 3.8 1.6 -1.8      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.81              # recorded: release to idle
ammo = 0
charge-time = 2            # recorded: 0.75 a second, full at 2 s gave 90
charge-min = 0             # script: ImpactHammer, no least charge; recorded 0.5 s gave 23
charge-max = 1.5           # script: ImpactHammer caps the charge at 1.5; recorded
charge-scales = damage
damage = 60                # recorded: 60 x charge
momentum = 66000           # recorded: 66000 x charge
range = 120                # script: ImpactHammer.TraceFire
reach = 90                 # script: ImpactHammer.ProcessTraceHit, a body farther from the firer takes nothing
self-momentum = 69000      # script: ImpactHammer.ProcessTraceHit, x charge, the charge at least 1 (rule)
self-damage = 36           # script: ImpactHammer.ProcessTraceHit, a surface hurts the firer, whatever the charge
rule = hammer              # script: ImpactHammer.Firing, a body 25 ahead fires it once the charge passes 1

[fire impact-hammer alt]
archetype = melee
offset = 3.8 1.6 -1.8      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.81              # recorded
ammo = 0
damage = 20                # script: ImpactHammer.ProcessAltTraceHit, x distance / 180; recorded 3 to 6
                           # the distance runs 0.4 of a body's radius into it (Pawn.AdjustHitLocation),
                           # less a thousandth of the trace (UPrimitive.LineCheck); recorded
momentum = 30000           # script: ImpactHammer.ProcessAltTraceHit, x distance / 180
range = 180                # script: ImpactHammer.TraceAltFire
distance-scale = 180       # script: ImpactHammer.ProcessAltTraceHit
self-momentum = 40000      # script: ImpactHammer.ProcessAltTraceHit, a surface, x distance / 180
self-damage = 24           # script: ImpactHammer.ProcessAltTraceHit, a surface, x distance / 180

[weapon chainsaw]
class = botpack.chainsaw
slot = 1                   # default: ChainSaw.InventoryGroup
ammo-max = 0
ammo-start = 0
switch-time = 0.77         # recorded: from the Enforcer, key to first shot

[fire chainsaw primary]
archetype = melee
offset = 2 3.6 4.1         # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.3               # script: ChainSaw sleeps 0.15 twice a trace; recorded
refire-lead = -0.137       # script: the press cuts, and the next cut is one sleep and a tick on; recorded
ammo = 0
damage = 20                # recorded
momentum = -15000          # script: ChainSaw.TraceFire, -15000 along the aim: it pulls; recorded
range = 100                # script: ChainSaw.TraceFire, 10 + Range (default 90)
range-from = body          # script: ChainSaw.TraceFire ends its trace that far from the owner's centre

[fire chainsaw alt]
archetype = melee
offset = 12 3.6 4.1        # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 1.6               # recorded: slash to slash while held, at 30, 85 and 120 fps
wind-up = 0.305            # recorded: the slash lands past 0.3 and by 0.312 s after the press, a tap too
ammo = 0
damage = 110               # recorded
momentum = 0
momentum-side = -10000     # script: ChainSaw.Slash, -10000 along the right-hand axis; recorded
range = 90                 # default: ChainSaw.Range
range-from = body          # script: ChainSaw.Slash ends its trace that far from the owner's centre

[weapon enforcer]
class = botpack.enforcer
slot = 2                   # default: Enforcer.InventoryGroup
ammo-max = 199             # default: Miniammo.MaxAmmo
ammo-start = 30            # default: Enforcer.PickupAmmoCount
switch-time = 1.02         # recorded: from the Shock Rifle, key to first shot

[fire enforcer primary]
archetype = instant-hit
offset = 3.3 5.5 -4.4      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.4               # recorded at 30 fps only
ammo = 1
spread = 104               # script: Weapon.TraceFire, accuracy 0.2 over 10000
damage = 17                # SS 4.9: Enforcer.HitDamage
momentum = 3000            # SS 4.9
push-chance = 0.2          # SS 4.9: one hit in five
push-scale = 5             # SS 4.9
range = 10000              # script: Weapon.TraceFire

[fire enforcer alt]
archetype = instant-hit
offset = 3.3 5.5 -4.4      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.287             # recorded at 85 fps only
wind-up = 0.185            # recorded at 30, 85 and 120 fps: Enforcer.AltFiring turns the gun before its first shot, a tap too
ammo = 1
spread = 208               # script: Enforcer, accuracy 0.4 growing 0.5 a shot to 3.4 (rule to build)
damage = 17                # SS 4.9: Enforcer.HitDamage
momentum = 3000            # SS 4.9
push-chance = 0.2          # SS 4.9: one hit in five
push-scale = 5             # SS 4.9
range = 10000              # script: Weapon.TraceFire

[weapon bio-rifle]
class = botpack.ut_biorifle
slot = 3                   # default: UT_BioRifle.InventoryGroup
ammo-max = 100             # default: BioAmmo.MaxAmmo
ammo-start = 25            # default: UT_BioRifle.PickupAmmoCount
switch-time = 0.77         # recorded: from the Enforcer, key to first shot

[fire bio-rifle primary]
archetype = projectile
offset = 13.7 11.85 -6.95  # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.286             # recorded at 30, 85 and 120 fps
refire-lead = 0.022        # recorded: a hold's first interval is 0.307 to 0.331
ammo = 1
projectile = bio-gel

[fire bio-rifle alt]
archetype = projectile
offset = 13.7 11.85 -6.95  # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.73              # recorded: release to idle
ammo = 1
charge-time = 4.1          # script: UT_BioRifle stops stepping at a charge of 4.1
charge-min = 1             # script: UT_BioRifle, the glob's scale is 1 + 0.8 x charge
charge-max = 4.28          # script: UT_BioRifle caps the charge at 4.1
charge-step = 0.5          # script: UT_BioRifle.AltFiring, a round and the hold each time it passes 0.5 s
charge-scales = damage     # the glob's momentum too, and its radius (splash-radius-max)
projectile = bio-glob
count = 1

[weapon shock-rifle]
class = botpack.shockrifle
slot = 4                   # default: ShockRifle.InventoryGroup
ammo-max = 50              # default: ShockCore.MaxAmmo
ammo-start = 20            # default: ShockRifle.PickupAmmoCount
switch-time = 0.77         # recorded: from the Enforcer, key to first shot

[fire shock-rifle primary]
archetype = instant-hit
offset = 4.4 6.7 -9.6      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.79              # recorded at 30 fps only
ammo = 1
damage = 40                # recorded
momentum = 60000           # recorded
range = 10000              # script: ShockRifle.TraceFire

[fire shock-rifle alt]
archetype = projectile
offset = 14.4 6.7 -9.6     # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.52              # recorded
ammo = 1
projectile = shock-ball

[weapon pulse-gun]
class = botpack.pulsegun
slot = 5                   # default: PulseGun.InventoryGroup
ammo-max = 199             # default: PAmmo.MaxAmmo
ammo-start = 60            # default: PulseGun.PickupAmmoCount
switch-time = 0.73         # recorded: from the Enforcer, key to first shot

[fire pulse-gun primary]
archetype = projectile
offset = 16.5 15 -10.78    # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed; script: 10.78 down
refire = 0.182             # recorded: PulseGun sleeps 0.18, to the tick
refire-lead = 0.013        # recorded: a hold's second shot is a tick later, at 30, 85 and 120 fps
ammo = 1
projectile = plasma
spiral-radius = 4          # script: PulseGun.ProjectileFire, 4 round the offset
spiral-turn = 18775        # script: 1.8 radians a shot, the first straight up; recorded

[fire pulse-gun alt]
archetype = beam
offset = 16.5 15 0         # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.1               # unmeasured: a beam fires every tick held
ammo = 1                   # script: PulseGun.AltFiring, a round each time the hold passes ammo-every; recorded
press-ammo = 1             # script: PulseGun.AltFire, the press spends one; recorded
ammo-every = 0.24          # script: PulseGun.AltFiring; recorded
damage = 72                # default: StarterBolt.Damage; SS 4.9: per second of hold
momentum = 0               # SS 4.9: none with the 469 default NoLockdown=1; recorded
range = 810                # script: PBolt, ten pieces of 81
hit-every = 0.22           # SS 4.9: PBolt's stored hits
extend = 6259              # script: PBolt adds a piece of 81 a tick; here a tick is 1.1 / 85 s
first-hit = 0.1            # script: PBolt.CheckBeam, a first touch hurts as 0.1 s of hold; recorded

[weapon ripper]
class = botpack.ripper
slot = 6                   # default: Ripper.InventoryGroup
ammo-max = 75              # default: BladeHopper.MaxAmmo
ammo-start = 15            # default: Ripper.PickupAmmoCount
switch-time = 1.03         # recorded: from the Enforcer, key to first shot

[fire ripper primary]
archetype = projectile
offset = 3 16.6 -15.4      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.384             # recorded: the mean interval at 30, 85 and 120 fps
refire-lead = 0.022        # recorded: a hold's first interval is 0.404 to 0.409 at those rates
ammo = 1
projectile = razor

[fire ripper alt]
archetype = projectile
offset = 3 16.6 -15.4      # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.711             # recorded: the mean interval at 30, 85 and 120 fps; its first is no longer
ammo = 1
projectile = razor-alt

[weapon minigun]
class = botpack.minigun2
slot = 7                   # default: Minigun2.InventoryGroup
ammo-max = 199             # default: Miniammo.MaxAmmo
ammo-start = 50            # default: Minigun2.PickupAmmoCount
switch-time = 0.84         # recorded: from the Enforcer, key to first shot

[fire minigun primary]
archetype = instant-hit
offset = 2.1 5.35 -5.7     # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.13              # script: Minigun2.NormalFire sleeps 0.13 between bullets
wind-up = 0.13             # script: Minigun2.NormalFire sleeps 0.13 before its first bullet
repress = 0.424            # recorded at 85 and 120 fps: NormalFire's AnimEnd calls Fire again, a round and a new wind-up
ammo = 1
press-ammo = 1             # script: Minigun2.Fire uses a round and fires none; recorded
spread = 104               # script: Minigun2.TraceFire, accuracy 0.2 over 10000
damage = 9                 # SS 4.9: Minigun2.TraceFire, 9 + Rand(6); recorded
damage-random = 5          # SS 4.9
momentum = 0               # SS 4.9: none with the 469 default NoLockdown=1
range = 10000              # script: Minigun2.TraceFire

[fire minigun alt]
archetype = instant-hit
offset = 2.1 5.35 -5.7     # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.08              # script: Minigun2.AltFiring's FastShoot sleeps 0.08; recorded 0.074 at 30 fps, 0.078 at 85, 0.083 at 120
wind-up = 0.13             # script: Minigun2.AltFiring sleeps 0.13 before its first bullet
spin-up = 0.5              # recorded: the Shoot2 animation starts 0.5 after the press, and the faster sleep with it
spin-refire = 0.13         # script: Minigun2.AltFiring sleeps 0.13 until then
ammo = 1
press-ammo = 1             # script: Minigun2.AltFire uses a round and fires none; recorded
spread = 495               # script: Minigun2.TraceFire, accuracy 0.95 over 10000
damage = 9                 # SS 4.9: Minigun2.TraceFire, 9 + Rand(6); recorded
damage-random = 5          # SS 4.9
momentum = 0               # SS 4.9: none with the 469 default NoLockdown=1
range = 10000              # script: Minigun2.TraceFire

[weapon flak-cannon]
class = botpack.ut_flakcannon
slot = 8                   # default: UT_FlakCannon.InventoryGroup
ammo-max = 50              # default: FlakAmmo.MaxAmmo
ammo-start = 10            # default: UT_FlakCannon.PickupAmmoCount
switch-time = 1.35         # recorded: from the Enforcer, key to first shot

[fire flak-cannon primary]
archetype = projectile
offset = 11.5 12 -16.65    # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.77              # recorded: a tap, fire to idle
ammo = 1
spread = 0                 # script: every chunk takes the aim; flak-chunk's turn-random spreads them
rule = flak-spread         # script: UT_FlakCannon.Fire, each chunk from its own place up to 2 right and 1 up or down
projectile = flak-chunk
count = 8                  # script: UT_FlakCannon.Fire; recorded

[fire flak-cannon alt]
archetype = projectile
offset = 11.5 12 -16.65    # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 1.06              # recorded
ammo = 1
projectile = flak-shell

[weapon rocket-launcher]
class = botpack.ut_eightball
slot = 9                   # default: UT_Eightball.InventoryGroup
ammo-max = 48              # default: RocketPack.MaxAmmo
ammo-start = 6             # default: UT_Eightball.PickupAmmoCount
switch-time = 0.88         # recorded: from the Enforcer, key to first shot

[fire rocket-launcher primary]
archetype = projectile
offset = 12.4 6 -11        # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.9               # recorded: one rocket, fire to idle
ammo = 1
rule = rocket-fan          # script: UT_Eightball.FireRockets, a circle of radius 4 fanned 600 a radian
charge-time = 4.42         # unused by a stepped count charge
charge-min = 0.1667
charge-max = 1
charge-step = 0.9          # recorded: one more rocket, and a round, every 0.9 s; the sixth fires itself
charge-step-last = 0.833   # recorded: the sixth's, past 4.431 and by 4.435 s of hold at 85 and 120 fps
charge-scales = count
projectile = rocket
count = 6                  # script: UT_Eightball loads at most six; recorded

[fire rocket-launcher alt]
archetype = projectile
offset = 12.4 6 -11        # SS 4.9: PlayerViewOffset plus the class's FireOffset, right-handed
refire = 0.9               # recorded: one grenade, fire to idle
ammo = 1
rule = grenade-cluster     # script: UT_Eightball.FireRockets, a circle of radius 7, several turned +-750
charge-time = 4.42         # unused by a stepped count charge
charge-min = 0.1667
charge-max = 1
charge-step = 0.9          # recorded: as the primary
charge-step-last = 0.833   # recorded: as the primary
charge-scales = count
projectile = grenade
count = 6                  # script: UT_Eightball; recorded

[weapon sniper-rifle]
class = botpack.sniperrifle
slot = 0                   # default: SniperRifle.InventoryGroup is 10, the 0 key
ammo-max = 50              # default: BulletBox.MaxAmmo
ammo-start = 8             # default: SniperRifle.PickupAmmoCount
switch-time = 0.88         # recorded: from the Enforcer, key to first shot

[fire sniper-rifle primary]
archetype = instant-hit
offset = 0 0 0             # SS 4.9: the sniper starts at the eye
refire = 0.66              # recorded
ammo = 1
damage = 45                # SS 4.9: SniperRifle.ProcessTraceHit, a body; recorded
momentum = 30000           # SS 4.9; recorded
range = 10000              # script: SniperRifle.TraceFire
head-damage = 100          # SS 4.9; recorded
head-momentum = 35000      # SS 4.9; recorded
# No alt fire: the sniper's alt zooms, the client's (SS 3 item 7).

[projectile bio-gel]
speed = 840                # default: UT_BioGel.speed
radius = 2                 # default: UT_BioGel.CollisionRadius
gravity = 0.5              # recorded: UT_BioGel falls (PHYS_Falling) at half the zone's gravity
lifetime = 12              # default: UT_BioGel.LifeSpan
damage = 40                # script: UT_BioGel.Explode, Damage 20 x DrawScale 2; recorded 37 near the edge
momentum = 40000           # script: UT_BioGel.Explode, 20000 x 2; recorded
splash-radius = 150        # script: UT_BioGel.Explode, 75 x DrawScale
splash-from = moved        # script: UT_BioGel.Timer, HurtRadius at Location
strike = stick
fuse = 3.8                 # script: UT_BioGel, 3.8 s once landed, 3 s in flight (rule to build)
lift = 120                 # SS 4.9: UT_BioGel's Flying state

[projectile bio-glob]
speed = 700                # default: BioGlob.speed
radius = 2                 # default: BioGlob.CollisionRadius
gravity = 0.5              # recorded: BioGlob falls (PHYS_Falling) at half the zone's gravity
lifetime = 12              # default: BioGlob.LifeSpan
damage = 75                # default: BioGlob.Damage, x the charge's scale
momentum = 30000           # default: BioGlob.MomentumTransfer, x the scale
splash-radius = 75         # script: UT_BioGel.Timer, 75 x the scale
splash-radius-max = 250    # script: UT_BioGel.Timer, at most 250
splash-from = moved        # script: UT_BioGel.Timer, as the gel
strike = stick
fuse = 3.8                 # script: UT_BioGel, as the gel
lift = 120                 # SS 4.9: BioGlob extends UT_BioGel

[projectile shock-ball]
speed = 1000               # default: ShockProj.speed
radius = 12                # default: ShockProj.CollisionRadius
lifetime = 10              # default: ShockProj.LifeSpan
damage = 55                # default: ShockProj.Damage
momentum = 70000           # default: ShockProj.MomentumTransfer
splash-radius = 70         # script: ShockProj.Explode
splash-from = moved        # script: ShockProj.Explode, HurtRadius at Location
strike = explode
combo = shock-combo

[projectile plasma]
speed = 1450               # default: PlasmaSphere.speed
radius = 0                 # default: PlasmaSphere.CollisionRadius
lifetime = 2               # script: PlasmaSphere sets 2 on spawn; its default reads 0.5
damage = 20                # default: PlasmaSphere.Damage; recorded
momentum = 10000           # default: PlasmaSphere.MomentumTransfer; recorded
strike = explode

[projectile razor]
speed = 1300               # default: Razor2.speed
radius = 0                 # default: Razor2.CollisionRadius
lifetime = 6               # default: Razor2.LifeSpan
max-speed = 1200           # default: Razor2.MaxSpeed, under its speed; recorded from its first move
damage = 30                # default: Razor2.Damage; recorded
momentum = 15000           # default: Razor2.MomentumTransfer; recorded
strike = bounce
bounces = 6                # script: Razor2.HitWall, gone on the seventh wall
bounce-keep = 1            # script: Razor2.HitWall, a plain reflection

[projectile razor-alt]
speed = 1300               # default: Razor2Alt.speed
radius = 0                 # default: Razor2Alt.CollisionRadius
lifetime = 6               # default: Razor2Alt.LifeSpan
max-speed = 1200           # default: Razor2.MaxSpeed, inherited; recorded
damage = 34                # default: Razor2Alt.Damage; recorded
momentum = 87000           # default: Razor2Alt.MomentumTransfer; recorded
splash-radius = 180        # script: Razor2Alt.BlowUp
body-hit = direct          # script: Razor2Alt.ProcessTouch, TakeDamage along its flight
splash-up-max = 0.45       # script: Razor2Alt.BlowUp, dir.Z at most 0.45
strike = explode

[projectile flak-chunk]
speed = 2500               # default: UTChunk1.speed
radius = 0                 # default: UTChunk1.CollisionRadius
lifetime = 2.9             # default: UTChunk1.LifeSpan
speed-random = 100         # SS 4.9: UTChunk, speed +-100
turn-random = 1000         # SS 4.9: UTChunk, yaw and pitch +-1000
damage = 16                # default: UTChunk1.Damage; recorded
momentum = 10000           # default: UTChunk1.MomentumTransfer; recorded
strike = bounce
bounces = 100              # script: UTChunk.HitWall, no limit; its lifetime ends it
bounce-keep = 0.8          # script: UTChunk.HitWall, 0.8 along the wall
bounce-off = 0.32          # script: UTChunk.HitWall, 0 to 0.64 off it, at random
bounce-off-random = 0.32
bounce-gravity = 0.5       # recorded: PHYS_Falling from its first bounce, at half the zone's gravity (bBounce true)

[projectile flak-shell]
speed = 1200               # default: flakslug.speed
radius = 0                 # default: flakslug.CollisionRadius
gravity = 0.5              # recorded: flakslug falls (PHYS_Falling); half the zone's gravity before its move
gravity-after = 0.5        # recorded: and half after it, as it does not bounce (bBounce false)
lifetime = 6               # default: flakslug.LifeSpan
damage = 70                # default: flakslug.Damage
momentum = 75000           # default: flakslug.MomentumTransfer; recorded 69000 near the edge
splash-radius = 150        # script: flakslug.Explode
strike = split
split-into = flak-chunk
split-count = 5            # script: flakslug.Explode; recorded
split-spread = 0           # script: each chunk keeps the slug's aim, turned by its own turn-random
lift = 200                 # SS 4.9: flakslug

[projectile rocket]
speed = 900                # default: RocketMk2.speed
radius = 0                 # default: RocketMk2.CollisionRadius
lifetime = 6               # default: RocketMk2.LifeSpan
damage = 75                # default: RocketMk2.Damage; recorded
momentum = 80000           # default: RocketMk2.MomentumTransfer; recorded
splash-radius = 220        # script: RocketMk2.Explode
strike = explode
acceleration = 50          # SS 4.9: RocketMk2
max-speed = 1600           # default: RocketMk2.MaxSpeed

[projectile grenade]
speed = 650                # SS 4.9: UT_Grenade, 600 + FRand() * 100
speed-random = 50          # SS 4.9
lift = 210                 # SS 4.9
inherit = 0.4              # SS 4.9: of the firer's velocity along the aim
radius = 0                 # default: UT_Grenade.CollisionRadius
gravity = 0.5              # recorded: UT_Grenade falls (PHYS_Falling) at half the zone's gravity
lifetime = 2.75            # SS 4.9: UT_Grenade's fuse, 2.5 + FRand() * 0.5
lifetime-random = 0.25     # SS 4.9
expire = explode
damage = 80                # default: UT_Grenade.Damage; recorded
momentum = 50000           # default: UT_Grenade.MomentumTransfer; recorded
splash-radius = 200        # script: UT_Grenade.Explosion
strike = bounce
bounces = 100              # script: UT_Grenade.HitWall, bounces until its fuse
bounce-keep = 0.75         # SS 4.9: UT_Grenade.HitWall

[combo shock-combo]
damage = 165               # script: ShockProj.SuperExplosion, Damage x 3
momentum = 140000          # script: ShockProj.SuperExplosion, MomentumTransfer x 2
splash-radius = 250        # script: ShockProj.SuperExplosion
