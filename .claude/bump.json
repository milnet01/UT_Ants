{
  "$why": "CMakeLists.txt's project() VERSION is the only version-bearing line (git grep, 2026-11-04). post_check holds it in lockstep with the newest dated CHANGELOG heading.",
  "version_source": "CMakeLists.txt",
  "version_pattern": "project\\(UT_Ants\\s+VERSION\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
  "files": [
    {
      "path": "CMakeLists.txt",
      "pattern": "VERSION {OLD}\n    DESCRIPTION",
      "replace": "VERSION {NEW}\n    DESCRIPTION"
    }
  ],
  "tag": "v{NEW}",
  "post_check": "v=$(sed -nE 's/^ +VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)$/\\1/p' CMakeLists.txt | head -n1); h=$(grep -m1 -oE '^## \\[[0-9]+\\.[0-9]+\\.[0-9]+\\] - [0-9]{4}-[0-9]{2}-[0-9]{2}' CHANGELOG.md); echo \"CMake $v, CHANGELOG: $h\"; [ -n \"$v\" ] && [ \"${h#\"## [$v] - \"}\" != \"$h\" ]"
}
