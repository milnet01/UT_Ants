#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

// Clustered light culling -- UTA-0014 SS 4.6. One invocation per cluster: the
// lights whose sphere of influence reaches the cluster's view-space box, nearest
// the box's centre first, at most CLUSTER_CAPACITY of them. A cluster that had
// more drops the furthest and sets CLUSTER_OVERFLOW on its count (SS 6).
//
// A sphere is conservative for a spotlight, which only ever lights less.

#define UTA_CLUSTER_WRITER
#include "scene_bindings.glsl"
#include "light.glsl"

layout(set = 0, binding = 4) buffer ClusterCountBlock { uint clusterCounts[]; };
layout(set = 0, binding = 5) buffer ClusterIndexBlock { uint clusterIndices[]; };

layout(local_size_x = 64) in;

// Whether the segment from `a` to `b` meets the box from `lo` to `hi`: the slab
// test, clipping the segment's parameter against each axis in turn.
bool segmentMeetsBox(vec3 a, vec3 b, vec3 lo, vec3 hi) {
    vec3 d = b - a;
    float enter = 0.0;
    float leave = 1.0;
    for (int axis = 0; axis < 3; ++axis) {
        if (abs(d[axis]) < 1e-6) {
            if (a[axis] < lo[axis] || a[axis] > hi[axis]) return false;
            continue;
        }
        float t1 = (lo[axis] - a[axis]) / d[axis];
        float t2 = (hi[axis] - a[axis]) / d[axis];
        enter = max(enter, min(t1, t2));
        leave = min(leave, max(t1, t2));
        if (enter > leave) return false;
    }
    return true;
}

void main() {
    uint cluster = gl_GlobalInvocationID.x;
    if (cluster >= frame.clusterGrid.x * frame.clusterGrid.y * frame.clusterGrid.z) return;

    vec3 lo = clusterBounds[cluster].minimum.xyz;
    vec3 hi = clusterBounds[cluster].maximum.xyz;
    vec3 centre = (lo + hi) * 0.5;

    uint chosen[CLUSTER_CAPACITY];
    float nearness[CLUSTER_CAPACITY];
    uint count = 0u;
    bool overflowed = false;

    for (uint i = 0u; i < frame.lightCount; ++i) {
        vec3 p = (frame.view * vec4(lights[i].location, 1.0)).xyz;
        float radius = lightRadius(lights[i].radius);
        float key;
        if (lights[i].span == vec3(0.0)) {
            vec3 gap = clamp(p, lo, hi) - p;
            // The falloff is zero at the radius, so touching is not reaching.
            if (dot(gap, gap) >= radius * radius) continue;
            key = distance(p, centre);
        } else {
            // UTA-0162 SS 4.4: a strip reaches where its segment meets the box
            // grown by its radius -- conservative at the grown box's corners.
            vec3 q = (frame.view * vec4(lights[i].location + lights[i].span, 1.0)).xyz;
            if (!segmentMeetsBox(p, q, lo - vec3(radius), hi + vec3(radius))) continue;
            vec3 s = q - p;
            key = distance(p + s * clamp(dot(centre - p, s) / dot(s, s), 0.0, 1.0), centre);
        }
        uint slot;
        if (count < CLUSTER_CAPACITY) {
            slot = count++;
        } else {
            overflowed = true;
            if (key >= nearness[CLUSTER_CAPACITY - 1u]) continue;
            slot = CLUSTER_CAPACITY - 1u;
        }
        // Insertion into a list kept nearest first.
        while (slot > 0u && nearness[slot - 1u] > key) {
            nearness[slot] = nearness[slot - 1u];
            chosen[slot] = chosen[slot - 1u];
            --slot;
        }
        nearness[slot] = key;
        chosen[slot] = i;
    }

    for (uint k = 0u; k < count; ++k) clusterIndices[cluster * CLUSTER_CAPACITY + k] = chosen[k];
    clusterCounts[cluster] = count | (overflowed ? CLUSTER_OVERFLOW : 0u);
}
