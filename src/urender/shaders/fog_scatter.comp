#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

// UTA-0015 SS 4.3 stage 1: each froxel's in-scattered light and extinction.
//
// A light scatters into the haze only when it has shadow faces, or is the
// flashlight: an unshadowed light would shine through walls (SS 6).

#define UTA_FOG_PASS
#include "scene_bindings.glsl"
#include "clusters.glsl"
#include "flame.glsl"
#include "fog.glsl"
#include "light.glsl"
#include "shadows.glsl"

// Set 1's binding numbers are ShaderTypes.h's gpu::FogBinding.
layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D scattering;
layout(set = 1, binding = 2) readonly buffer VolumeLightBlock { uint volumeLights[]; };
// UTA-0333: shadow_reduce.comp's copy of the atlas.
layout(set = 1, binding = 3, r32f) uniform readonly image2D hazeShadow;
// UTA-0356: last frame's scattering, which this frame's blends with.
layout(set = 1, binding = 4) uniform sampler3D history;

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// UTA-0215: under water, the lights scatter in the water as well as the haze
// does, this much a unit at a pattern of 1. This item's call, chosen on
// DM-ArcaneTemple's pool, not fitted: the original draws no shafts.
const float WATER_SCATTER = 3.0e-4;
// World units across one cell of the shafts' pattern.
const float SHAFT_CELL = 96.0;

// How much of the water's scattering a point at world (x, y) takes at light
// time `t`: two drifting value noises, raised to the sixth so light gathers in
// a few narrow bright columns. It ignores height, so the columns stand
// upright, as light falling through a rippled surface does. Its mean is about
// 1, pow(n, 6) averaging about 1/7 over the noise.
float waterShafts(vec2 p, float t) {
    vec2 q = p / SHAFT_CELL;
    float n = 0.6 * flameNoise(q + vec2(0.13, 0.07) * t, 41u) + 0.4 * flameNoise(q * 2.3 - vec2(0.05, 0.11) * t, 42u);
    float n3 = n * n * n;
    return 7.0 * n3 * n3;
}

// UTA-0333: how lit `x` is by `light`, from one texel of the haze's copy of
// the atlas -- the nearest depth of the HAZE_SHADOW_STEP square of atlas
// texels it covers (shadow_reduce.comp) -- kept
// inside the light's tile. Haze has no edge to see.
float hazeShadowOf(Light light, vec3 x) {
    ShadowFace shadow;
    vec4 clip;
    vec2 uv;
    float depth;
    if (!shadowLookup(light, x, shadow, clip, uv, depth)) return 1.0;
    vec2 size = vec2(imageSize(hazeShadow));
    ivec2 first = ivec2(shadow.atlasRect.xy * size + 0.5);
    ivec2 last = ivec2((shadow.atlasRect.xy + shadow.atlasRect.zw) * size + 0.5) - 1;
    ivec2 at = clamp(ivec2(uv * size), first, last);
    return depth <= imageLoad(hazeShadow, at).r ? 1.0 : 0.0;
}

// UTA-0356: where last frame held this texel's centre -- the depth whose
// fogCoordinate is the texel's. False if that was outside last frame's volume.
bool historyAt(uvec3 id, out vec3 at) {
    vec2 centreUv = (vec2(id.xy) + 0.5) / vec2(FOG_GRID.xy);
    float centreZ = sliceDepth(float(id.z) + 0.5);
    vec3 centre = vec3((centreUv.x * 2.0 - 1.0) * fog.tanHalfFov.x * centreZ,
                       (1.0 - centreUv.y * 2.0) * fog.tanHalfFov.y * centreZ, centreZ);
    vec4 clip = frame.previousViewProjUnjittered * (fog.viewToWorld * vec4(centre, 1.0));
    if (clip.w <= 0.0) return false;
    at = vec3(clip.xy / clip.w * 0.5 + 0.5, fogCoordinate(clip.w));
    return all(greaterThanEqual(at, vec3(0.0))) && all(lessThanEqual(at, vec3(1.0)));
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, FOG_GRID))) return;

    // After a cut the weight is 1 and nothing is read.
    vec3 previous;
    bool hasHistory = fog.historyWeight < 1.0 && historyAt(id, previous);

    // UTA-0352: a frame lights every second workgroup, in turn, and the others
    // keep what the history holds. Whole workgroups: the GPU runs invocations in
    // batches that last as long as their slowest, so skipping every second
    // froxel saved nothing on the RX 6600.
    uvec3 group = gl_WorkGroupID;
    if (hasHistory && ((group.x + group.y + group.z) & 1u) != uint(fog.jitter.w)) {
        imageStore(scattering, ivec3(id), textureLod(history, previous, 0.0));
        return;
    }

    // UTA-0356: a ray through the tile at fog.jitter, at that fraction of the
    // slice's depth -- the centre ray at the middle depth after a cut. In
    // viewOf's axes: +X right, +Y up, +Z ahead; the region's top-left is uv (0, 0).
    // A shadow edge sampled at one depth per slice repeats once per slice; the
    // jitter moves it, and the history averages the copies away.
    vec2 uv = (vec2(id.xy) + fog.jitter.xy) / vec2(FOG_GRID.xy);
    float near = sliceDepth(float(id.z)), far = sliceDepth(float(id.z + 1u));
    float z = 0.5 * (near + far) + (fog.jitter.z - 0.5) * (far - near);
    vec3 viewPoint = vec3((uv.x * 2.0 - 1.0) * fog.tanHalfFov.x * z, (1.0 - uv.y * 2.0) * fog.tanHalfFov.y * z, z);
    vec3 x = (fog.viewToWorld * vec4(viewPoint, 1.0)).xyz;
    vec3 v = normalize(x - frame.eye);

    float extinction = HAZE_EXTINCTION * fog.hazeScale;
    vec3 scattered = vec3(0.0);

    // UTA-0215: under water the same lights scatter in the water too.
    bool water = frame.cameraUnderwater != 0u;
    if (fog.hazeScale > 0.0 || water) {
        uint cluster = clusterOf(uv * frame.viewportSize, z);
        uint count = clusterCounts[cluster] & ~CLUSTER_OVERFLOW;
        vec3 haze = vec3(0.0);
        for (uint k = 0u; k < count; ++k) {
            uint index = clusterIndices[cluster * CLUSTER_CAPACITY + k];
            Light light = lights[index];
            if (light.shadowFaceCount == 0u && index != fog.flashlight) continue;
            // UTA-0352: a cluster lists every light whose sphere touches it, and
            // many reach no froxel in it, or do not reach this one past a wall.
            // Those stop here, before the shadow read that costs the most.
            vec3 through = lightThrough(light, x);
            if (max(through.r, max(through.g, through.b)) <= 0.0) continue;
            float lit = hazeShadowOf(light, x);
            if (lit == 0.0) continue;
            vec3 toLight = litFrom(light, x) - x;
            float d = length(toLight);
            float cosTheta = d > 0.0 ? dot(v, toLight / d) : 1.0;
            haze += through * (light.flicker * lit * phaseOf(cosTheta));
        }
        float share = HAZE_SCATTER * fog.hazeScale + (water ? WATER_SCATTER * waterShafts(x.xy, frame.flameSeconds) : 0.0);
        scattered += haze * share;
    }

    for (uint k = 0u; k < fog.volumeLightCount; ++k) {
        Light light = lights[volumeLights[k]];
        float f = lightFalloff(distance(litFrom(light, x), x), lightRadius(light.volumeRadius));
        if (f == 0.0) continue;
        float glow = float(light.brightness) / 255.0 * float(light.volumeBrightness) / 64.0;
        // Unshadowed, as UT99 draws it: on DM-Fetid, whose one volumetric light
        // sits below the floor, a shadowed glow drew nothing the original shows.
        scattered += displayedToLinear(lightColour(light.hue, light.saturation)) * (glow * f * VOLUME_GLOW_SCALE);
        extinction += float(light.volumeFog) / 255.0 * f * VOLUME_FOG_SCALE;
    }

    // UTA-0215 SS 4.3: what the water between the eye and this froxel keeps.
    scattered *= waterKept(z, frame.cameraUnderwater);
    vec4 sampled = vec4(scattered, extinction);

    // UTA-0356: blended with what last frame held at this texel's centre.
    if (hasHistory) sampled = mix(textureLod(history, previous, 0.0), sampled, fog.historyWeight);
    imageStore(scattering, ivec3(id), sampled);
}
