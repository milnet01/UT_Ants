#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

// UTA-0015 SS 4.3 stage 1: each froxel's in-scattered light and extinction.
//
// A light scatters into the haze only when it has shadow faces, or is the
// flashlight: an unshadowed light would shine through walls (SS 6).

#define UTA_FOG_PASS
#include "scene_bindings.glsl"
#include "clusters.glsl"
#include "flame.glsl"
#include "fog.glsl"
#include "light.glsl"
#include "shadows.glsl"

layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D scattering;
layout(set = 1, binding = 2) readonly buffer VolumeLightBlock { uint volumeLights[]; };

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// UTA-0215: under water, the lights scatter in the water as well as the haze
// does, this much a unit at a pattern of 1. This item's call, chosen on
// DM-ArcaneTemple's pool, not fitted: the original draws no shafts.
const float WATER_SCATTER = 3.0e-4;
// World units across one cell of the shafts' pattern.
const float SHAFT_CELL = 96.0;

// How much of the water's scattering a point at world (x, y) takes at light
// time `t`: two drifting value noises, raised to the sixth so light gathers in
// a few narrow bright columns. It ignores height, so the columns stand
// upright, as light falling through a rippled surface does. Its mean is about
// 1, pow(n, 6) averaging about 1/7 over the noise.
float waterShafts(vec2 p, float t) {
    vec2 q = p / SHAFT_CELL;
    float n = 0.6 * flameNoise(q + vec2(0.13, 0.07) * t, 41u) + 0.4 * flameNoise(q * 2.3 - vec2(0.05, 0.11) * t, 42u);
    float n3 = n * n * n;
    return 7.0 * n3 * n3;
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, FOG_GRID))) return;

    // The tile's centre ray at the slice's middle depth, in viewOf's axes:
    // +X right, +Y up, +Z ahead; the region's top-left is uv (0, 0).
    vec2 uv = (vec2(id.xy) + 0.5) / vec2(FOG_GRID.xy);
    float z = 0.5 * (sliceDepth(float(id.z)) + sliceDepth(float(id.z + 1u)));
    vec3 viewPoint = vec3((uv.x * 2.0 - 1.0) * fog.tanHalfFov.x * z, (1.0 - uv.y * 2.0) * fog.tanHalfFov.y * z, z);
    vec3 x = (fog.viewToWorld * vec4(viewPoint, 1.0)).xyz;
    vec3 v = normalize(x - frame.eye);

    float extinction = HAZE_EXTINCTION * fog.hazeScale;
    vec3 scattered = vec3(0.0);

    // UTA-0215: under water the same lights scatter in the water too.
    bool water = frame.cameraUnderwater != 0u;
    if (fog.hazeScale > 0.0 || water) {
        uint cluster = clusterOf(uv * frame.viewportSize, z);
        uint count = clusterCounts[cluster] & ~CLUSTER_OVERFLOW;
        vec3 haze = vec3(0.0);
        for (uint k = 0u; k < count; ++k) {
            uint index = clusterIndices[cluster * CLUSTER_CAPACITY + k];
            Light light = lights[index];
            if (light.shadowFaceCount == 0u && index != fog.flashlight) continue;
            vec3 toLight = litFrom(light, x) - x;
            float d = length(toLight);
            float cosTheta = d > 0.0 ? dot(v, toLight / d) : 1.0;
            haze += lightThrough(light, x) * (light.flicker * shadowOf(light, x) * phaseOf(cosTheta));
        }
        float share = HAZE_SCATTER * fog.hazeScale + (water ? WATER_SCATTER * waterShafts(x.xy, frame.flameSeconds) : 0.0);
        scattered += haze * share;
    }

    for (uint k = 0u; k < fog.volumeLightCount; ++k) {
        Light light = lights[volumeLights[k]];
        float f = lightFalloff(distance(litFrom(light, x), x), lightRadius(light.volumeRadius));
        if (f == 0.0) continue;
        float glow = float(light.brightness) / 255.0 * float(light.volumeBrightness) / 64.0;
        // Unshadowed, as UT99 draws it: on DM-Fetid, whose one volumetric light
        // sits below the floor, a shadowed glow drew nothing the original shows.
        scattered += displayedToLinear(lightColour(light.hue, light.saturation)) * (glow * f * VOLUME_GLOW_SCALE);
        extinction += float(light.volumeFog) / 255.0 * f * VOLUME_FOG_SCALE;
    }

    // UTA-0215 SS 4.3: what the water between the eye and this froxel keeps.
    scattered *= waterKept(z, frame.cameraUnderwater);
    imageStore(scattering, ivec3(id), vec4(scattered, extinction));
}
