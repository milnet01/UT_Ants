#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

// UTA-0015 SS 4.3 stage 2: each froxel column, front to back, into the light
// reaching the eye and the transmittance -- the energy-conserving form from
// Hillaire's "Physically Based and Unified Volumetric Rendering in Frostbite",
// SIGGRAPH 2015. Texel k holds the integral to slice k's far edge.

#define UTA_FOG_PASS
#include "scene_bindings.glsl"
#include "fog.glsl"

layout(set = 1, binding = 0, rgba16f) uniform readonly image3D scattering;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image3D integrated;

layout(local_size_x = 8, local_size_y = 8) in;

// Below this an extinction is treated as none, where (S - S * T) / sigma loses
// its precision.
const float NO_EXTINCTION = 1.0e-7;

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(id, FOG_GRID.xy))) return;

    // The column's ray is this much longer than the depth it crosses.
    vec2 uv = (vec2(id) + 0.5) / vec2(FOG_GRID.xy);
    float stretch = length(vec3((uv.x * 2.0 - 1.0) * fog.tanHalfFov.x, (1.0 - uv.y * 2.0) * fog.tanHalfFov.y, 1.0));

    vec3 scattered = vec3(0.0);
    float transmittance = 1.0;
    for (uint k = 0u; k < FOG_GRID.z; ++k) {
        vec4 slice = imageLoad(scattering, ivec3(id, k));
        float delta = (sliceDepth(float(k + 1u)) - sliceDepth(float(k))) * stretch;
        float sigma = slice.a;
        float sliceT = exp(-sigma * delta);
        vec3 sliceS = sigma > NO_EXTINCTION ? (slice.rgb - slice.rgb * sliceT) / sigma : slice.rgb * delta;
        scattered += transmittance * sliceS;
        transmittance *= sliceT;
        imageStore(integrated, ivec3(id, k), vec4(scattered, transmittance));
    }
}
