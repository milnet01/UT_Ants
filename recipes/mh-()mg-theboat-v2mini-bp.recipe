ut-ants recipe 8
# MH-()mG-TheBoat-V2mini-BP's sun -- UTA-0346, from scripts/map-analyser.py's sky survey.
# Its sky is clear light blue with no sun painted on it (UTA-0344; the user
# chose a sun, 2026-10-11). The survey's views stand below deck, so the yaw
# is a pick.
#
# Its sky is only painted: ShaneDay.DayskyB on a closed box, with no sky
# zone, so it drew black and the sun lit nothing. [sky] opens it (UTA-0350),
# with the default colours and cloud cover.
#
# Below deck the original lit by zone ambient alone, which stays withdrawn,
# so those decks drew 0.01-0.18 of its mean grey (UTA-0344, 2026-10-19).
# Each [lamp] copies Light12, the cabin lantern's light, and wears Lantern5,
# its lantern, as a mesh fitting that draws once UTA-0341 draws meshes. Rows
# run along the aft lower deck and the forward hold, two low at the bow end.
#
# Brush12, a subtracted wedge, cuts a pit through the sea floor whose wall
# shows as a stone triangle in open water, in the original too. [hide pit]
# drops it and draws the sea over the opening (UTA-0396, user 2026-10-23).

[map]
file = mh-()mg-theboat-v2mini-bp
sha256 = c25996b4856ad0c901632428520437f88d06497f8c5f485d577eedb8669d699b

[sun]
yaw = 40960
pitch = 9102
hue = 28
saturation = 200
brightness = 200

[sky]
textures = shaneday.dayskyb

[lamp aft-1]
light = Light12
